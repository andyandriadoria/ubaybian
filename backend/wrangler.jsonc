{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ubaybian-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-11",
  "keep_vars": true,
  "vars": {
    "FRONTEND_ORIGIN": "https://andyandriadoria.github.io",
    "SESSION_TTL_DAYS": "30",
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbwT9wFvlDBh21IvLUXWoXwkThwmpZgX-H-VN8DrP6mZLxRYIFmiYNGpiGnUc73SEqzv8w/exec"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ubaybian",
      "database_id": "48f8ba15-18f7-41d3-9ae4-725380d563c8"
    }
  ]
}
